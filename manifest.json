{
  "manifest_version": 3,
  "name": "WA Contacts Extractor & Group Number Downloader",
  "version": "1.0.0",
  "description": "Extract WhatsApp group contacts with detailed info: name, phone, country code, business status, admin status, labels and more. Export to CSV or Excel.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}